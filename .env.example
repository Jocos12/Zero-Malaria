# ZeroMalaria environment example — copy to /.env (never commit secrets)
ZM_DEMO_MODE=true
ZM_DEMO_PASSWORD=demo1234
ZM_JWT_SECRET=zeromalaria-demo-secret-change-in-production
# prompt = dismissible password modal (default); enforce = must change before API use
ZM_PASSWORD_CHANGE_POLICY=prompt

# Frontend (Vite) — synthetic banner only; never put AI keys here
VITE_DEMO_MODE=true

# --- AI keys (backend only; loaded at API startup; never log values) ---
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b
# Aliases (optional):
# ZM_GEMINI_API_KEY=
# ZM_GROQ_API_KEY=

AI_PROVIDER_MODE=cascade
AI_TIMEOUT_SECONDS=12
ZM_AI_CHAT_TIMEOUT_SECONDS=8
ZM_AI_FAIL_FAST_SECONDS=2.5
ZM_AI_CIRCUIT_COOLDOWN_MINUTES=2
AI_COOLDOWN_MINUTES=5
AI_DEBUG=false
ZM_AI_PROVIDER_ORDER=gemini,groq,local
ZM_GOOGLE_CLOUD_PROJECT=
ZM_GOOGLE_CLOUD_LOCATION=us-central1
# Path to GCP service account JSON (never commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=
# English voice engine: browser | vertex_tts | vertex_live
ZM_VOICE_ENGINE_EN=browser
# STT provider order (mock first in demo)
ZM_STT_PROVIDER_ORDER=mock,google_stt,mms,hf_whisper_kin,gemini_audio
# Pindo VoiceAI (server-side only). Create a token at https://app.pindo.io/login — leave it empty here.
ZM_PINDO_ACCESS_MODE=public
ZM_PINDO_API_TOKEN=
ZM_PINDO_API_BASE_URL=https://api.pindo.io
ZM_PINDO_TIMEOUT_SECONDS=20
